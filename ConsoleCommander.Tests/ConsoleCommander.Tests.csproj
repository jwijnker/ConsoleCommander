<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 expects test projects to be executable; keep OutputType as Exe -->
    <TargetFramework>net10.0</TargetFramework>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <!-- Add Microsoft.NET.Test.Sdk to opt into the supported test SDK and avoid older MTP targets -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- Use xUnit.net v2 for stable test discovery/execution with current test SDK -->
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
    <!-- xUnit abstractions provide ITestOutputHelper used by tests */ -->
    <PackageReference Include="xunit.abstractions" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsoleCommander\ConsoleCommander.csproj" />
  </ItemGroup>

</Project>
